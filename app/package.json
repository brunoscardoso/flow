{
  "name": "@plan-flow/app",
  "productName": "Flow",
  "version": "0.2.0",
  "private": true,
  "description": "Flow — an Electron IDE where the agent thread is a first-class surface",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "node ../scripts/postinstall.mjs",
    "build:cli": "node ../scripts/build-cli-bundle.mjs",
    "predev": "node ../scripts/set-dev-app-name.mjs && npm run build:cli",
    "dev": "electron-vite dev",
    "build": "npm run build:cli && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.guest.json",
    "test": "node scripts/run-jest.mjs",
    "e2e": "npm run build && playwright test",
    "e2e:run": "playwright test",
    "e2e:bg": "FLOW_E2E=1 FLOW_E2E_BACKGROUND=1 playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "rebuild": "node ../scripts/rebuild-native.mjs && node ../scripts/fix-native-perms.mjs",
    "package": "npm run verify:agent-binary && npm run build:cli && electron-vite build && electron-builder --mac --dir -c.mac.identity=null",
    "package:dmg": "npm run verify:agent-binary && npm run build:cli && electron-vite build && electron-builder --mac dmg -c.mac.identity=null",
    "package:win": "node scripts/verify-agent-binary.mjs --target win32-x64 && npm run build:cli && electron-vite build && electron-builder --win && node scripts/verify-agent-binary.mjs --target win32-x64 dist/win-unpacked",
    "release": "node scripts/release.mjs",
    "ship": "node scripts/ship.mjs",
    "bridge-release": "node scripts/bridge-release.mjs",
    "verify:agent-binary": "node scripts/verify-agent-binary.mjs",
    "install:local": "node scripts/install-local.mjs",
    "perf": "node scripts/run-jest.mjs --config jest.perf.cjs --runInBand"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.295",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^3.6.0",
    "electron-updater": "^6.8.9",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0",
    "typescript": "^5.9.3",
    "typescript-language-server": "^4.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "electron": "43.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "vite": "^7.0.0"
  }
}
